# =============================================================================
# AURAMINATOR.IN - ENTERPRISE COMMERCE CONFIGURATION
# =============================================================================

# 1. CORE SYSTEM CONSTRAINTS
NEXT_PUBLIC_SITE_URL="https://auraminator.in"
NODE_ENV="development"

# 2. SUPABASE BACKEND & AUTH (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://placeholder-supabase.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder-anon-key"
SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-key"

# 3. CLOUDFLARE R2 SECURE STORAGE (Dashboard -> R2)
CLOUDFLARE_ACCOUNT_ID="placeholder-cloudflare-account-id"
R2_ACCESS_KEY_ID="placeholder-r2-access-key-id"
R2_SECRET_ACCESS_KEY="placeholder-r2-secret-access-key"
R2_BUCKET_NAME="auraminator-assets"

# 4. PAYMENTS & ESCROW SPLITS (Razorpay Route / Cashfree)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="placeholder-webhook-secret"

# 5. SHIPROCKET AUTOMATED LOGISTICS
SHIPROCKET_EMAIL="fulfillment@auraminator.in"
SHIPROCKET_PASSWORD="placeholder-shiprocket-password"

# 6. DISTRIBUTED CACHING & SEARCH
UPSTASH_REDIS_REST_URL="https://placeholder-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="placeholder-redis-token"
TYPESENSE_API_KEY="placeholder-typesense-key"
NEXT_PUBLIC_TYPESENSE_HOST="placeholder-typesense-host"

# 7. MULTI-MODAL AI COPILOT
AI_API_KEY="placeholder-ai-key"
